[user]
	email = jamesdenismccarthy@gmail.com
	name = Donagh
[credential]
	helper = cache
[init]
	defaultBranch = main
	defaultBranc = main
[safe]
	; directory = /run/media/donagh/01d4c077-4709-4b5b-9431-087bc9060d68/DONAGHS/MY_ZIM/Computer
    directory = /run/media/donagh/USB128GB/DONAGHS/MY_ZIM/Computer
	; directory = /mnt/cifs_share/RSYNCED/personal
[core]
	editor = vim
[alias]
	staash = stash --all
	gsw = "git switch "
[column]
	ui = auto
[branch]
	sort = -committerdate

# from https://blog.gitbutler.com/how-git-core-devs-configure-git
# clearly makes git better

[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true

# why the hell not?

[help]
        autocorrect = prompt
[commit]
        verbose = true
[rerere]
        enabled = true
        autoupdate = true
[core]
        excludesfile = ~/.gitignore
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true

# a matter of taste (uncomment if you dare)

[core]
        # fsmonitor = true
        # untrackedCache = true
[merge]
        # (just 'diff3' if git version < 2.3)
        # conflictstyle = zdiff3
[pull]
        # rebase = true
